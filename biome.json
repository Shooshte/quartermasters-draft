{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.output",
      "!**/.turbo",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!apps/web/src/routeTree.gen.ts",
      "!packages/api-client/src/generated.ts",
      "!packages/api-client/openapi.json",
      "!fixtures/engine-parity",
      "!crates/qd-db/seed-data.json",
      "!crates/qd-db/schema-signatures.json",
      "!crates/qd-db/legacy-schema-signatures.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
