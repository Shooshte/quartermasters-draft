{
  "name": "@qd/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "^1.5.3",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.20.3",
    "vitest": "^4.0.18"
  }
}
